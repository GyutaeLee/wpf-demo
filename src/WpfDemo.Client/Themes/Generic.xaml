<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:WpfDemo.Controls">
    <Style TargetType="{x:Type controls:StatusBadge}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusBadge}">
                    <Border x:Name="BadgeBorder" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" CornerRadius="10"
                            Padding="9,4" HorizontalAlignment="Left">
                        <TextBlock x:Name="BadgeText" Text="{TemplateBinding Status}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Status" Value="사용 가능">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                        </Trigger>
                        <Trigger Property="Status" Value="대여 중">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                        </Trigger>
                        <Trigger Property="Status" Value="점검 중">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
