<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:WpfDemo.Controls">
    <Style TargetType="{x:Type controls:StatusBadge}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusBadge}">
                    <Border x:Name="BadgeBorder" Background="#E9EEF5" CornerRadius="10"
                            Padding="9,4" HorizontalAlignment="Left">
                        <TextBlock x:Name="BadgeText" Text="{TemplateBinding Status}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#43536D" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Status" Value="대기">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="#EDF1F6" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="#4B5D77" />
                        </Trigger>
                        <Trigger Property="Status" Value="진행 중">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="#E6F0FF" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="#175EAF" />
                        </Trigger>
                        <Trigger Property="Status" Value="완료">
                            <Setter TargetName="BadgeBorder" Property="Background" Value="#E5F5EC" />
                            <Setter TargetName="BadgeText" Property="Foreground" Value="#207548" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
