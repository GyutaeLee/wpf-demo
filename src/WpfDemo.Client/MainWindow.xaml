<Window x:Class="WpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfDemo.Controls"
        Title="WPF Worklist" Width="960" Height="650"
        MinWidth="800" MinHeight="460" Background="#F5F7FA"
        FontFamily="Malgun Gothic, Segoe UI" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="WORKLIST / DESKTOP" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Accent}" />
                <TextBlock Text="업무 목록" FontSize="27" FontWeight="SemiBold" Margin="0,5,0,2" />
                <TextBlock Text="가상 업무 항목을 조회하고 상태와 메모를 편집합니다."
                           FontSize="13" Foreground="{StaticResource MutedInk}" />
            </StackPanel>
            <Border Grid.Column="1" Background="#E9EFF7" CornerRadius="5" Padding="10,7"
                    VerticalAlignment="Top" Margin="12,0,0,0">
                <TextBlock Text="로컬 REST API" FontSize="11" Foreground="#425775" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="320" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="6*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E0E6EF" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="목록" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="새로고침" Command="{Binding LoadCommand}"
                                AutomationProperties.AutomationId="ReloadButton" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="134" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="검색" FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanNavigate}"
                                     AutomationProperties.Name="업무 번호, 제목 또는 분류 검색"
                                     AutomationProperties.AutomationId="SearchBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="상태" FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding StatusFilter, Mode=TwoWay}"
                                      IsEnabled="{Binding CanNavigate}"
                                      AutomationProperties.AutomationId="StatusFilter" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="3">
                        <ListBox ItemsSource="{Binding VisibleItems}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 IsEnabled="{Binding CanNavigate}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="업무 목록"
                                 AutomationProperties.AutomationId="WorkItemList">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=WorkItem{0}}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="5" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedInk}" Margin="0,6,0,0">
                                                    <Run Text="#" /><Run Text="{Binding Id}" /><Run Text="  ·  " /><Run Text="{Binding Category}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <controls:StatusBadge Grid.Column="1" Status="{Binding Status}"
                                                                  Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasLoadError}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="목록을 불러오는 중…" FontSize="14" Foreground="{StaticResource MutedInk}" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLoadError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="목록을 불러오지 못했습니다." FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="로컬 API가 실행 중인지 확인해 주세요." FontSize="12"
                                       Foreground="{StaticResource MutedInk}" Margin="0,8,0,14"
                                       HorizontalAlignment="Center" />
                            <Button Content="다시 시도" Command="{Binding LoadCommand}"
                                    AutomationProperties.AutomationId="LoadRetryButton" HorizontalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="조건에 맞는 업무가 없습니다." FontSize="14"
                                   Foreground="{StaticResource MutedInk}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E0E6EF" BorderThickness="1"
                    CornerRadius="8" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="왼쪽 목록에서 업무를 선택해 주세요." FontSize="15"
                               Foreground="{StaticResource MutedInk}" VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <TextBlock Text="상세 편집" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="선택한 업무의 상태와 메모를 수정합니다." FontSize="12"
                                       Foreground="{StaticResource MutedInk}" Margin="0,5,0,20" />
                            <Border Background="#F5F8FC" CornerRadius="5" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedItem.Title}" FontSize="18" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,6,0,10">
                                        <Run Text="업무 #" /><Run Text="{Binding SelectedItem.Id}" />
                                        <Run Text="  ·  " /><Run Text="{Binding SelectedItem.Category}" />
                                    </TextBlock>
                                    <controls:StatusBadge Status="{Binding EditedStatus}"
                                                          AutomationProperties.Name="현재 편집 상태" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="상태" FontSize="13" FontWeight="SemiBold" Margin="0,22,0,7" />
                            <ComboBox ItemsSource="{Binding EditableStatuses}"
                                      SelectedItem="{Binding EditedStatus, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEdit}"
                                      AutomationProperties.AutomationId="EditStatus" />
                            <TextBlock Text="메모" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,7" />
                            <TextBox Text="{Binding EditedNote, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEdit}" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" MinHeight="122" MaxHeight="180"
                                     VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.AutomationId="EditNote" />
                            <TextBlock Text="200자 이내 · 선택 입력" FontSize="11"
                                       Foreground="{StaticResource MutedInk}" Margin="0,7,0,0" />
                            <TextBlock Text="{Binding ValidationMessage}" Foreground="#B42318"
                                       FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ValidationMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1">
                        <Border Background="#FFF3F0" CornerRadius="5" Padding="10" Margin="0,12,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSaveError}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="저장하지 못했습니다. 입력 내용은 유지됩니다. 다시 시도해 주세요."
                                       Foreground="#A1281D" FontSize="12" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="SaveError" />
                        </Border>
                        <TextBlock Text="{Binding Notice}" Foreground="#207548" FontSize="12"
                                   Margin="0,12,0,0" AutomationProperties.AutomationId="SaveNotice">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNotice}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="취소" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                IsCancel="True" AutomationProperties.AutomationId="CancelButton" />
                        <Button Content="저장 / 다시 시도" Command="{Binding SaveCommand}"
                                IsDefault="True" AutomationProperties.AutomationId="SaveButton" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="API 연결이 끊기면 다시 시도할 수 있습니다."
                   FontSize="11" Foreground="{StaticResource MutedInk}" Margin="0,13,0,0" />
    </Grid>
</Window>
