<Window x:Class="WpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfDemo.Controls"
        Title="wpf-demo — 장비 대여" Width="1040" Height="720"
        MinWidth="820" MinHeight="520" Background="{StaticResource Canvas}"
        FontFamily="Malgun Gothic, Segoe UI" Foreground="{StaticResource Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="EQUIPMENT / DESKTOP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                <TextBlock Text="장비 대여·반납" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,1" />
                <TextBlock Text="장비 상태와 대여 이력을 확인합니다." FontSize="13" Foreground="{StaticResource MutedInk}" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" CornerRadius="5" Padding="10,7"
                    VerticalAlignment="Top" Margin="12,0,0,0">
                <TextBlock Text="로컬 API" FontSize="11" Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" />
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="290" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="6*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="장비 목록" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="새로고침" Command="{Binding RefreshCommand}"
                                AutomationProperties.AutomationId="ReloadButton" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="검색" FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,0,0,5" />
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanNavigate}"
                                     AutomationProperties.Name="장비 코드, 이름 또는 분류 검색"
                                     AutomationProperties.AutomationId="SearchBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="상태" FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding StatusFilter, Mode=TwoWay}"
                                      IsEnabled="{Binding CanNavigate}"
                                      AutomationProperties.AutomationId="StatusFilter" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" CornerRadius="4" Padding="8,5" Margin="0,8,0,0"
                            Visibility="{Binding HasStaleResults, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="이전 조회 결과입니다. 연결을 복구한 뒤 새로고침해 주세요." FontSize="11"
                                   Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                                   AutomationProperties.AutomationId="StaleResultsNotice" />
                    </Border>
                    <Grid Grid.Row="3">
                        <ListBox ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 IsEnabled="{Binding CanNavigate}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="장비 목록"
                                 AutomationProperties.AutomationId="EquipmentList">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,7" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=Equipment{0}}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}" BorderThickness="1" CornerRadius="5" Padding="10,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedInk}" Margin="0,4,0,0">
                                                    <Run Text="{Binding Code}" /><Run Text="  ·  " /><Run Text="{Binding Category}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <controls:StatusBadge Grid.Column="1" Status="{Binding Status}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding HasNoResultsLoadError}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>
                        <TextBlock Text="장비를 불러오는 중…" FontSize="14" Foreground="{StaticResource MutedInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasNoResultsLoadError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style></StackPanel.Style>
                            <TextBlock Text="목록을 새로고침하지 못했습니다." FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="{Binding LoadMessage}" FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,7,0,12" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button Content="다시 시도" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="조건에 맞는 장비가 없습니다." FontSize="14" Foreground="{StaticResource MutedInk}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}" BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="왼쪽 목록에서 장비를 선택해 주세요." FontSize="15" Foreground="{StaticResource MutedInk}"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding HasSelection}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style></ScrollViewer.Style>
                        <StackPanel>
                            <TextBlock Text="장비 상세" FontSize="17" FontWeight="SemiBold" />
                            <Border Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" CornerRadius="5" Padding="13" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedItem.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,5,0,9">
                                        <Run Text="{Binding SelectedItem.Code}" /><Run Text="  ·  " /><Run Text="{Binding SelectedItem.Category}" />
                                    </TextBlock>
                                    <controls:StatusBadge Status="{Binding SelectedItem.Status}" AutomationProperties.Name="장비 상태" />
                                    <StackPanel Visibility="{Binding HasActiveLoan, Converter={StaticResource BooleanToVisibility}}" Margin="0,10,0,0">
                                        <TextBlock FontSize="12"><Run Text="대여자: " /><Run Text="{Binding SelectedItem.ActiveLoan.BorrowerName}" /></TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedInk}" Margin="0,3,0,0">
                                            <Run Text="대여 시각(UTC): " /><Run Text="{Binding SelectedItem.ActiveLoan.BorrowedAtUtc}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="대여자" FontSize="13" FontWeight="SemiBold" Margin="0,15,0,5" />
                            <ComboBox ItemsSource="{Binding Borrowers}" SelectedItem="{Binding SelectedBorrower, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" IsEnabled="{Binding CanChooseBorrower}"
                                      AutomationProperties.Name="대여자 선택"
                                      AutomationProperties.AutomationId="BorrowerSelector" />
                            <TextBlock Text="메모" FontSize="13" FontWeight="SemiBold" Margin="0,13,0,5" />
                            <TextBox Text="{Binding DraftNote, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                                     AutomationProperties.Name="대여 및 반납 메모"
                                     AutomationProperties.AutomationId="OperationNote" />
                            <TextBlock Text="선택 입력 · 200자 이내" FontSize="11" Foreground="{StaticResource MutedInk}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" FontSize="12" Margin="0,5,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers><DataTrigger Binding="{Binding ValidationMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <Grid Margin="0,17,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="대여 이력" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="불러오는 중…" FontSize="11" Foreground="{StaticResource MutedInk}"
                                           Visibility="{Binding IsLoadingHistory, Converter={StaticResource BooleanToVisibility}}" />
                            </Grid>
                            <TextBlock Text="이력을 불러오지 못했습니다." FontSize="12"
                                       Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                                       Visibility="{Binding HasHistoryError, Converter={StaticResource BooleanToVisibility}}" />
                            <TextBlock Text="아직 대여 이력이 없습니다." FontSize="12" Foreground="{StaticResource MutedInk}"
                                       Visibility="{Binding ShowNoHistoryMessage, Converter={StaticResource BooleanToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding History}" AutomationProperties.AutomationId="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}" BorderThickness="0,1,0,0" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" FontSize="12" MinWidth="46" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding BorrowerName}" FontSize="12" />
                                                    <TextBlock Text="{Binding OccurredAtUtc}" FontSize="10" Foreground="{StaticResource MutedInk}" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" CornerRadius="5" Padding="10" Margin="0,10,0,0"
                            Visibility="{Binding HasPendingOperation, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <controls:LiveRegionTextBlock Text="{Binding OperationMessage}" FontSize="12"
                                                          Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" TextWrapping="Wrap"
                                                          AutomationProperties.LiveSetting="Polite"
                                                          AutomationProperties.AutomationId="OperationStatus" />
                            <Button Content="같은 요청으로 다시 시도" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                    AutomationProperties.AutomationId="RetryButton" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" CornerRadius="5" Padding="10" Margin="0,10,0,0"
                            Visibility="{Binding HasRecoveryError, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="저장된 요청을 읽지 못했습니다. 파일을 보존했으며 새 요청을 보낼 수 없습니다."
                                   FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                                   TextWrapping="Wrap" AutomationProperties.AutomationId="RecoveryError" />
                    </Border>
                    <controls:LiveRegionTextBlock Grid.Row="1" Text="{Binding OperationMessage}"
                                                   Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" FontSize="12" Margin="0,10,0,0"
                                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                                   AutomationProperties.AutomationId="OperationNotice">
                        <controls:LiveRegionTextBlock.Style><Style TargetType="controls:LiveRegionTextBlock"><Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPendingOperation}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding HasRecoveryError}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding OperationMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding OperationMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style></controls:LiveRegionTextBlock.Style>
                    </controls:LiveRegionTextBlock>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="취소" Command="{Binding CancelCommand}" Margin="0,0,7,0"
                                AutomationProperties.AutomationId="CancelButton" />
                        <Button Content="대여" Command="{Binding BorrowCommand}" IsDefault="{Binding CanBorrow}"
                                AutomationProperties.AutomationId="BorrowButton" />
                        <Button Content="반납" Command="{Binding ReturnCommand}" IsDefault="{Binding CanReturn}" Margin="7,0,0,0"
                                AutomationProperties.AutomationId="ReturnButton" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="모든 장비와 대여 기록은 시연용 가상 데이터입니다."
                   FontSize="11" Foreground="{StaticResource MutedInk}" Margin="0,10,0,0" />
    </Grid>
</Window>
